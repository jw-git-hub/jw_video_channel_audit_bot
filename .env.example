# Образец: только имена. Настоящий .env создаётся вручную на сервере, в папке бота,
# с правами 600. В git и на Мак он не попадает, выкладка его не трогает.

# Токен бота @jw_video_channel_audit_bot от @BotFather — новый, после перевыпуска (ТЗ, Сек14)
BOT_TOKEN=
# Ключ своего проекта Google Cloud, ограниченный одним YouTube Data API v3 (ТЗ, Ю9)
YOUTUBE_API_KEY=
# Telegram ID владельца: /stats, /channel, /forget, уведомления, полный доступ до запуска
ADMIN_ID=
